# рабочий вариант загрузки связей стран и групп

from main.models import Country, CountryGroup

cis_ids = (
    9, 16, 34, 113, 119, 185, 219, 228, 244
)

group = CountryGroup.objects.get(id=2) # id=2 это СНГ

for country in Country.objects.filter(id__in=cis_ids):
    country.groups.set([group])
	
	Ключевые признаки «чистого безвиза»:

не нужно заранее подавать заявки, заполнять электронные формы, получать разрешения;

не требуется оплачивать сборы за оформление въездных документов;

срок пребывания чётко определён и не требует продления в стране;

процесс прохождения границы быстрый и стандартизированный.